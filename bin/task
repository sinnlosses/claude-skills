#!/usr/bin/env python3
"""`task` コマンドの入口。PATH 上にこのファイルへの symlink を張ると、変数に入れずに
`task status` のように打てるようになる（T-557）。

symlink 越しでもこのファイル自身の実体を探して隣の `task.py` を呼ぶだけで、判断は一切持たない。
symlink を張る／外すのは人（`docs/task-workflow-redesign.md` 5.1、`skills/task-workflow/WORKFLOW.md`
「`task` コマンドの参照」）。
"""

from __future__ import annotations

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_task_py = os.path.join(_here, "..", "skills", "task-workflow", "scripts", "task.py")

os.execv(sys.executable, [sys.executable, _task_py, *sys.argv[1:]])
